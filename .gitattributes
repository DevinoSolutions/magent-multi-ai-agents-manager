# magent is a Windows tool — keep scripts as CRLF so cmd/PowerShell are happy.
* text=auto
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.md   text eol=lf
*.json text eol=lf
LICENSE text eol=lf
# Node scripts run under bash on Linux, where a CR is part of every command.
*.sh text eol=lf
