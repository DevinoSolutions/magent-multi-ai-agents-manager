# magent environment variables — set them in your environment, or copy
# this file to ~/.magent/.env and edit. magent reads ONLY that file,
# never the current directory's .env (which belongs to whatever project
# you happen to be standing in).
# Every MAGENT_* key must match a field in src/magent/env.py;
# unknown MAGENT_ vars are a hard error (closed schema).

# Sentry DSN — set to enable error reporting (optional, default: off)
# MAGENT_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ntfy topic URL — set to push needs-input/error notifications to your phone
# via the attention daemon (optional, default: off; also needs settings.attention.ntfy)
# MAGENT_NTFY_TOPIC=https://ntfy.example.com/your-topic

# Logging level — DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO when unset)
# MAGENT_LOG_LEVEL=INFO

# Should `magent serve` keep the Alt+V listener alive? (default: 1 / on)
# Set to 0 to own the listener's lifetime yourself — serve then never spawns,
# restarts or replaces it, and `magent status` still tells you whether one is
# running. Off is also what the test suites use, since the listener installs a
# system-wide keyboard hook.
# MAGENT_HOTKEY_SUPERVISOR=1

# Should `magent attention -d` keep the upload server alive? (default: 1 / on)
# The attention daemon probes settings.uploadPort every poll and starts a
# detached `magent serve` when nothing answers — serve is the process every
# upload and every Alt+V press goes through, and nothing else watches it.
# Set to 0 if you run serve under your own supervisor (or in a terminal you
# watch); it also honours settings.uploadServer, so a config with the upload
# server switched off is never second-guessed.
# MAGENT_UPLOAD_SUPERVISOR=1

# Seconds the supervisor waits between two respawn attempts (default: 60).
# The cooldown is what stops a serve that crashes on startup from being
# respawned in a tight loop — lower it only if you know why (the e2e tier does).
# MAGENT_UPLOAD_RESPAWN_COOLDOWN_S=60

# Should magent raise every live psmux process to above-normal priority?
# (default: 1 / on; Windows-only, no admin rights needed, and it never lowers
# a process anyone put above normal.) psmux is the keystroke path for every
# agent pane and is blocked on a pipe rather than competing for CPU, so under
# heavy load it loses the scheduler race to the fleet it is hosting and your
# typing lags. Set to 0 to leave every process's priority exactly as it is.
# MAGENT_PSMUX_BOOST=1

# Should a LOCAL Alt+V press paste natively instead of uploading? (default: 1
# / on.) When the listener is wired to this machine (no ssh host in its
# manifest), the pane's agent shares your clipboard, so Alt+V just delivers a
# Ctrl+V and the agent reads the image itself -- a real attachment, no BMP
# capture, no upload, no file under ~/.magent/uploads. Remote-wired listeners
# (magent attach) always keep the upload path; set to 0 to force it locally
# too (for panes whose agent cannot paste images natively).
# MAGENT_ALTV_NATIVE=1
